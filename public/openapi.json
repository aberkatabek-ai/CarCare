{
  "openapi": "3.0.3",
  "info": {
    "title": "CarCare API",
    "version": "1.0.0",
    "description": "Swagger setup for testing the CarCare backend. Authentication is JWT-cookie based: call /api/auth/login first, then use the protected endpoints from the same browser."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Vehicles"
    },
    {
      "name": "Maintenance"
    },
    {
      "name": "Service History"
    },
    {
      "name": "Issues"
    },
    {
      "name": "Documents"
    },
    {
      "name": "Costs"
    },
    {
      "name": "AI"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "carcare.at"
      }
    },
    "schemas": {
      "ApiMessage": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "full_name": {
            "type": "string"
          },
          "preferred_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "reminders_enabled": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "model_year": {
            "type": "integer",
            "nullable": true
          },
          "nickname": {
            "type": "string",
            "nullable": true
          },
          "license_plate": {
            "type": "string",
            "nullable": true
          },
          "vehicle_status": {
            "type": "string"
          },
          "ownership_status": {
            "type": "string"
          },
          "current_mileage": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MaintenancePlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "interval_km": {
            "type": "integer",
            "nullable": true
          },
          "interval_months": {
            "type": "integer",
            "nullable": true
          },
          "last_service_km": {
            "type": "integer",
            "nullable": true
          },
          "last_service_date": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ServiceRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "service_name": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date"
          },
          "completed_at_mileage": {
            "type": "integer"
          },
          "actual_cost": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "issue_title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "document_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "nullable": true
          },
          "document_number": {
            "type": "string",
            "nullable": true
          },
          "start_date": {
            "type": "string",
            "nullable": true
          },
          "expiry_date": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FuelEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "filled_at": {
            "type": "string",
            "format": "date"
          },
          "odometer_km": {
            "type": "integer"
          },
          "liters": {
            "type": "number"
          },
          "total_cost": {
            "type": "number"
          }
        }
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "expense_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "expense_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AiConversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "feedback_status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "fullName",
          "email",
          "password"
        ],
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "CreateVehicleRequest": {
        "type": "object",
        "required": [
          "brand",
          "model",
          "currentMileage"
        ],
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "modelYear": {
            "type": "integer"
          },
          "nickname": {
            "type": "string"
          },
          "licensePlate": {
            "type": "string"
          },
          "currentMileage": {
            "type": "integer"
          }
        }
      },
      "CreateMaintenancePlanRequest": {
        "type": "object",
        "required": [
          "vehicleId",
          "name",
          "category"
        ],
        "properties": {
          "vehicleId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "intervalKm": {
            "type": "integer"
          },
          "intervalMonths": {
            "type": "integer"
          },
          "lastServiceKm": {
            "type": "integer"
          },
          "lastServiceDate": {
            "type": "string",
            "format": "date"
          },
          "estimatedCost": {
            "type": "number"
          },
          "isCritical": {
            "type": "boolean"
          }
        }
      },
      "CreateFuelEntryRequest": {
        "type": "object",
        "required": [
          "vehicleId",
          "filledAt",
          "odometerKm",
          "liters",
          "totalCost"
        ],
        "properties": {
          "vehicleId": {
            "type": "integer"
          },
          "filledAt": {
            "type": "string",
            "format": "date"
          },
          "odometerKm": {
            "type": "integer"
          },
          "liters": {
            "type": "number"
          },
          "totalCost": {
            "type": "number"
          },
          "isFullTank": {
            "type": "boolean"
          },
          "station": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "CreateExpenseRequest": {
        "type": "object",
        "required": [
          "vehicleId",
          "expenseType",
          "title",
          "amount",
          "expenseDate"
        ],
        "properties": {
          "vehicleId": {
            "type": "integer"
          },
          "expenseType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "expenseDate": {
            "type": "string",
            "format": "date"
          },
          "odometerKm": {
            "type": "integer"
          },
          "provider": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "Health response"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and issue JWT auth cookies",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current user",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/profile": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": "string"
                  },
                  "preferredName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated"
          }
        }
      }
    },
    "/api/auth/password": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update password",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currentPassword": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated"
          }
        }
      }
    },
    "/api/auth/reminder-settings": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update reminder preferences",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "remindersEnabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reminder settings updated"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request a password reset code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset code queued"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset password with verification code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "code": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset"
          }
        }
      }
    },
    "/api/auth/account": {
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Delete current account",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currentPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account deleted"
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "List active vehicles",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle list"
          }
        }
      },
      "post": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Create a vehicle",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vehicle created"
          }
        }
      }
    },
    "/api/vehicles/archive": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "List sold vehicles",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archived vehicles"
          }
        }
      }
    },
    "/api/vehicles/{id}": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Get a vehicle by id",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle detail"
          }
        }
      },
      "patch": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Update a vehicle",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Delete a sold vehicle",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle deleted"
          }
        }
      }
    },
    "/api/vehicles/{id}/sell": {
      "patch": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Mark vehicle as sold",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle marked as sold"
          }
        }
      }
    },
    "/api/vehicles/{id}/mileage": {
      "patch": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Update vehicle mileage",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newMileage": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mileage updated"
          }
        }
      }
    },
    "/api/vehicles/{id}/mileage-history": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Get mileage history",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mileage history"
          }
        }
      }
    },
    "/api/vehicles/{id}/share-link": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Generate a share link",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Share link response"
          }
        }
      }
    },
    "/api/vehicles/{id}/handoff-package": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Export buyer handoff package",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buyer package"
          }
        }
      }
    },
    "/api/vehicles/{id}/verify-ownership": {
      "post": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Verify ownership",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "object",
                    "description": "Optional base64 file payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ownership verification result"
          }
        }
      }
    },
    "/api/public/vehicle-share/{token}": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Get public shared vehicle profile",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public vehicle profile"
          }
        }
      }
    },
    "/api/maintenance-plans": {
      "get": {
        "tags": [
          "Maintenance"
        ],
        "summary": "List maintenance plans",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Maintenance plans"
          }
        }
