PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"
EMAIL_PROVIDER=auto
EMAIL_FROM="CarCare <noreply@example.com>"
RESEND_API_KEY=""
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS="smtp-password"
SMTP_FROM=you@example.com
UPLOADS_DIRECTORY=uploads/documents
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-terra"
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=youraccount@gmail.com
# Recommended production path:
# EMAIL_PROVIDER=resend
# EMAIL_FROM="CarCare <noreply@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxxx
# For Render with a mounted disk later:
# UPLOADS_DIRECTORY=/opt/render/project/src/uploads/documents
