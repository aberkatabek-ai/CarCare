DATABASE_URL=postgresql://user:password@host:5432/carcare
SESSION_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
UPLOADS_DIRECTORY=uploads/documents
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=youraccount@gmail.com
# For Render with a mounted disk later:
# UPLOADS_DIRECTORY=/opt/render/project/src/uploads/documents
PORT=3000
NODE_ENV=development
